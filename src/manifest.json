{
  "manifest_version": 3,
  "name": "PinFix 页面标注",
  "version": "0.6.0",
  "description": "面向智能体的前端标注工具：生成精确定位的修复指令，可接入 SightLoop 闭环修复。",
  "author": "gujiangwen <francodeyvison183@gmail.com>",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PinFix 页面标注",
    "default_icon": { "192": "icon-192.png" }
  },
  "icons": { "192": "icon-192.png" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["widget.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-annotation": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "开始/取消标注"
    },
    "toggle-annotation-shot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "开始/取消截图标注"
    }
  }
}
