# SightLoop Daemon
# Bind loopback only. Never expose this port publicly.
SIGHTLOOP_HOST=127.0.0.1
SIGHTLOOP_PORT=7420

# Shared secret for X-SightLoop-Token (also accepts X-PinFix-Token).
# Generate: openssl rand -hex 32
SIGHTLOOP_TOKEN=dev-token-change-me

# Comma-separated absolute path prefixes. repo_path must resolve under one of these.
# Alias: PINFIX_ALLOWED_ROOTS is also read if SIGHTLOOP_ALLOWED_ROOTS is unset.
SIGHTLOOP_ALLOWED_ROOTS=/tmp,/home

# SQLite database path (relative to repo root or absolute)
SIGHTLOOP_DB_PATH=./data/projects.sqlite

# Markup workspace root (per-project subdirs are created under this)
MARKUP_WORKSPACE=./data/markup-workspace

# Dual adapter: self (default) | official
MARKUP_ADAPTER=self
# Set to 1 to best-effort probe `npx markup-mcp` when MARKUP_ADAPTER=official
MARKUP_MCP_ENABLED=0
# Optional MarkUp Pro license (never commit real values)
# MARKUP_LICENSE_KEY=

# Repo file locks directory
SIGHTLOOP_LOCK_DIR=./data/locks

# Agent runner: auto | mock | pi
# auto (default via unset): mock when no LLM key, pi when a key is present
# SIGHTLOOP_AGENT_RUNNER=mock

# --- Pi LLM (Daemon only — never put these in the extension) ---
# Pi-centric: ONE shared credential for Planner / Implementer / Reviewer / Judge.
# Roles only override models. If no key is set, mock AgentRunner + mock dual-loop roles.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SIGHTLOOP_LLM_API_KEY=
# PI_API_KEY=
# SIGHTLOOP_PI_PROVIDER=openai          # openai | anthropic | compatible
# SIGHTLOOP_PI_BASE_URL=                # optional OpenAI-compatible base
# SIGHTLOOP_LLM_MODEL=gpt-4o-mini       # default model when a role omits override
# Per-role model picks (optional):
# SIGHTLOOP_PLANNER_MODEL=
# SIGHTLOOP_IMPLEMENTER_MODEL=
# SIGHTLOOP_REVIEWER_MODEL=
# SIGHTLOOP_JUDGE_MODEL=
# Admin can also persist these under data/llm-settings.env (masked key in UI).

# Admin (Vite) — points at the daemon
VITE_DAEMON_URL=http://127.0.0.1:7420
VITE_DAEMON_TOKEN=dev-token-change-me

# --- Local DX (M5) ---
# Only for personal loopback notebooks. Never enable on shared hosts.
# When =1, POST /v1/dx/bootstrap may return the daemon token (loopback only).
SIGHTLOOP_DX_BOOTSTRAP=0
# Optional friendly label shown in /v1/dx/status
SIGHTLOOP_DX_LABEL=local

# --- Dual-loop LangGraph (M9) — default OFF ---
# SIGHTLOOP_DUAL_LOOP=0
# SIGHTLOOP_DUAL_LOOP_MOCK=1          # 1=mock Planner/Reviewer; 0=Pi-backed chat
# SIGHTLOOP_CROSS_JUDGE=0
# SIGHTLOOP_MAX_INNER_REFINES=2
# SIGHTLOOP_MAX_PLAN_ATTEMPTS=2
# Smoke helpers (never enable in prod):
# SIGHTLOOP_DUAL_LOOP_FORCE_REFINE=1
# SIGHTLOOP_DUAL_LOOP_FORCE_PLAN_FILES=etc/passwd
